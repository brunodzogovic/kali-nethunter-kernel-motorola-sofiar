#
# Known-good Kali NetHunter USB baseline for Motorola Moto G8 Power (sofiar)
#
# Hardware validated on stock RPES31.Q4U-47-35-9 userspace/vendor:
# touchscreen, Wi-Fi, fingerprint, audio and haptics all operational.
#
# This fragment intentionally does NOT enable SYSVIPC or mac80211.
#

CONFIG_USB_ACM=y

CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y

# Stock Motorola vendor modules use Motorola's production signing key.
# CONFIG_MODULE_SIG_FORCE is not set
