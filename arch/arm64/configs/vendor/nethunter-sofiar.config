#
# Kali NetHunter configuration additions for Motorola Moto G8 Power (sofiar)
#
# Applied on top of the Motorola stock RPES31.Q4U-47-35-9 configuration.
#
# This is the full-development fragment currently under validation.
# The known-good USB-only baseline is kept separately as
# arch/arm64/configs/vendor/nethunter-sofiar-usb.config.
#

# Full NetHunter userspace requirement
CONFIG_SYSVIPC=y

# USB serial support
CONFIG_USB_ACM=y

# USB ConfigFS functions used by NetHunter USB Arsenal
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y

# The stock Motorola /vendor modules are signed by Motorola's production key.
# A locally built kernel uses a different signing key, so forced signature
# enforcement must remain disabled when booting the stock vendor image.
# CONFIG_MODULE_SIG_FORCE is not set

# SYSVIPC changes genksyms CRCs for much of the kernel.  The stock Motorola
# vendor modules are prebuilt against the production CRC set, so allow only
# the explicit sofiar vendor-module allowlist in kernel/module.c to bypass
# modversion mismatches.  All other modules retain normal MODVERSIONS checks.
CONFIG_MOTO_VENDOR_MODVERSION_COMPAT=y

# Android's stock sofiar VINTF matrices require CONFIG_SYSVIPC=n.  Keep
# SYSVIPC active for NetHunter but omit that one symbol from the IKCONFIG
# compatibility view exposed as /proc/config.gz.
CONFIG_MOTO_VINTF_SYSVIPC_COMPAT=y

# NetHunter wireless foundation. The stock Motorola wlan driver remains the
# internal FullMAC path; mac80211 is added for external USB Wi-Fi adapters.
# These options follow Kali NetHunter's documented MAC80211 requirements.
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
